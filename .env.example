# Copie ce fichier en `.env` (déjà gitignoré) et renseigne tes valeurs.
# Les variables préfixées EXPO_PUBLIC_ sont injectées dans l'app au build.

# Clé API Etherscan (V2, une seule clé pour toutes les chaînes EVM).
# Sert à l'historique des transactions et aux transferts ERC-20.
# Obtiens-la gratuitement sur https://etherscan.io/myapikey
EXPO_PUBLIC_ETHERSCAN_KEY=
