# Copie ce fichier en `.env` (déjà gitignoré) et renseigne tes valeurs.
# Les variables préfixées EXPO_PUBLIC_ sont injectées dans l'app au build.
# Après modification : relancer avec `npx expo start -c` (cache vidé).

# --- Actives maintenant ---

# Alchemy : RPC dédié (fiabilité) pour Ethereum/Polygon/BNB/Base/Sepolia.
# Mis en tête des RPC ; les endpoints publics restent en fallback.
# Sert aussi aux soldes ERC-20 et NFT. (Solana/Bitcoin utilisent leurs RPC publics.)
EXPO_PUBLIC_ALCHEMY_KEY=

# Etherscan V2 : historique de transactions + transferts ERC-20 (multichain).
EXPO_PUBLIC_ETHERSCAN_KEY=

# CoinGecko (Demo) : prix, marché, graphiques, fiche token. Optionnel (marche sans clé).
EXPO_PUBLIC_COINGECKO_KEY=

# LI.FI : swap + bridge cross-chain (agrège DEX et bridges), une API pour tout.
# Utilisé par l'écran Échanger & Bridge (actif).
EXPO_PUBLIC_LIFI_KEY=

# WalletConnect (Reown) — project ID gratuit depuis cloud.reown.com (ex-WalletConnect Cloud).
# Sert à connecter Nova aux dApps.
EXPO_PUBLIC_WALLETCONNECT_ID=

# Relay (relay.link) : 2ᵉ source de devis cross-chain depuis l'EVM. OPTIONNEL —
# sans clé, Relay est ignoré (l'API refuse les devis anonymes) et LI.FI couvre tout.
EXPO_PUBLIC_RELAY_API_KEY=

# Sauvegarde Google Drive (coffre passif, zéro-connaissance — lib/googleDrive.ts).
# Google Cloud Console → API « Google Drive » activée → Identifiants → « ID client OAuth »
# de type ANDROID (nom du package com.kalyx.wallet + empreinte SHA-1 du keystore EAS :
# `eas credentials`) — et un second de type iOS si besoin. Pas de secret client.
# Portée demandée : drive.appdata uniquement (dossier privé de l'app).
# ⚠️ Nécessite un REBUILD natif : le schéma de redirection dérivé de cet ID est
# déclaré dans app.config.ts.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

EXPO_PUBLIC_HELIUS_KEY=d324bbde-ae57-4e19-b77b-0d2e757eb76c
