# En-têtes de sécurité servis par Cloudflare Pages pour le tableau de bord web.
# Le site ne stocke jamais de clé privée ; ces en-têtes ferment le reste.
#
# CSP bloquante, validée sur l'export web (dist) : aucun <script> inline, tous
# les chunks Metro chargés depuis l'origine, WASM (wasm-unsafe-eval, PAS eval
# JS), Web Workers en blob, polices auto-hébergées (public/fonts), images des
# réseaux/tokens/NFT en https uniquement, WalletConnect (relais wss + iframe
# Verify), SDK Telegram chargé seulement dans la mini-app. Embarquement en
# iframe interdit sauf Telegram (frame-ancestors) — X-Frame-Options volontairement
# absent : il bloquerait web.telegram.org.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://telegram.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https: wss:; worker-src 'self' blob:; child-src 'self' blob:; frame-src https://verify.walletconnect.com https://verify.walletconnect.org; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; object-src 'none'; base-uri 'self'; form-action 'none'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

/_expo/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
